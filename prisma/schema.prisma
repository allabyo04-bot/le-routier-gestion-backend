// Schéma de la base de données — Gestion Commerciale LE ROUTIER (vente de bouteilles de gaz)
// Premier lot : ventes, stock multi-dépôt, clients, dépenses/manquants/excédents, rapports
// journaliers, utilisateurs (2 rôles), journal d'audit.
// À venir dans une prochaine passe : inventaire (aller-retour Excel), facturation normalisée DGI
// (le champ typeFacture ci-dessous est déjà prévu pour ne pas bloquer cette évolution).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Depot {
  id        String   @id @default(cuid())
  nom       String   @unique
  adresse   String?
  actif     Boolean  @default(true)
  stocks    StockItem[]
  ventes    Vente[]
  ventesAttente VenteAttente[]
  mouvements MouvementStock[]
  operationsCaisse OperationCaisse[]
  usersParDefaut User[]
  createdAt DateTime @default(now())
}

model User {
  id             String   @id @default(cuid())
  nom            String
  identifiant    String   @unique
  motDePasseHash String   // haché avec bcrypt, jamais stocké en clair
  role           String   // "administrateur" | "operateur"
  actif          Boolean  @default(true)
  depotParDefautId String?
  depotParDefaut Depot?   @relation(fields: [depotParDefautId], references: [id])
  ventesCaissier Vente[]  @relation("ventesCaissier")
  ventesAnnulees Vente[]  @relation("ventesAnnulees")
  mouvementsStock MouvementStock[]
  operationsCaisse OperationCaisse[]
  journalAudit   JournalAudit[]
  createdAt      DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  code        String   @unique
  designation String
  prixAchat   Int
  prixVente   Int
  actif       Boolean  @default(true)
  stocks      StockItem[]
  lignes      LigneVente[]
  mouvements  MouvementStock[]
  createdAt   DateTime @default(now())
}

// Une ligne de stock par (article, dépôt).
model StockItem {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id])
  depotId     String
  depot       Depot    @relation(fields: [depotId], references: [id])
  quantite    Int      @default(0)
  seuilAlerte Int      @default(0)

  @@unique([articleId, depotId])
}

model Client {
  id                String   @id @default(cuid())
  raisonSociale     String
  ifu               String?
  telephone         String?  @unique
  adresse           String?
  estClientComptoir Boolean  @default(false)
  archive           Boolean  @default(false)
  ventes            Vente[]
  createdAt         DateTime @default(now())
}

model Vente {
  id              String   @id @default(cuid())
  numero          String   @unique // FVxxxxxxx — conserve le format existant du client
  date            DateTime @default(now())
  depotId         String
  depot           Depot    @relation(fields: [depotId], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  caissierId      String
  caissier        User     @relation("ventesCaissier", fields: [caissierId], references: [id])
  statut          String   @default("Validee") // "EnAttente" | "Validee" | "Annulee"
  typeFacture     String   @default("NonNormalisee") // "NonNormalisee" | "Normalisee" (phase DGI, plus tard)
  total           Int      @default(0)
  remiseGlobale   Int      @default(0)
  montantRecu     Int?     // somme remise par le client en caisse (facultatif : vente à crédit si absent)
  monnaieRendue   Int?     // montantRecu - total, calculé et figé au moment de la vente
  motifAnnulation String?
  annuleeParId    String?
  annuleePar      User?    @relation("ventesAnnulees", fields: [annuleeParId], references: [id])
  dateAnnulation  DateTime?
  lignes          LigneVente[]
  mouvementsStock MouvementStock[]
  createdAt       DateTime @default(now())
}

model LigneVente {
  id                String  @id @default(cuid())
  venteId           String
  vente             Vente   @relation(fields: [venteId], references: [id])
  articleId         String
  article           Article @relation(fields: [articleId], references: [id])
  designation       String  // copiée au moment de la vente (historique figé même si l'article change après)
  quantite          Int
  prixUnitaire      Int
  remise            Int     @default(0)
  sousTotal         Int
  prixAchatUnitaire Int     // copié au moment de la vente, pour un calcul de marge historisé et fiable
  margeLigne        Int
}

// Vente mise de côté le temps que le client revienne — stock non impacté tant qu'elle n'est pas validée.
model VenteAttente {
  id          String   @id @default(cuid())
  depotId     String
  depot       Depot    @relation(fields: [depotId], references: [id])
  label       String   // repère libre pour retrouver le ticket (nom client, numéro...)
  clientId    String?
  operateurId String
  panier      Json     // snapshot des lignes du panier au moment de la mise en attente
  createdAt   DateTime @default(now())
}

// Historique de tous les mouvements de stock : vente, annulation de vente, réapprovisionnement.
model MouvementStock {
  id            String   @id @default(cuid())
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id])
  depotId       String
  depot         Depot    @relation(fields: [depotId], references: [id])
  type          String   // "Vente" | "AnnulationVente" | "Reappro" | "RegularisationInventaire"
  quantite      Int      // signé : négatif en sortie, positif en entrée
  venteId       String?
  vente         Vente?   @relation(fields: [venteId], references: [id])
  effectueParId String
  effectuePar   User     @relation(fields: [effectueParId], references: [id])
  date          DateTime @default(now())
}

// Dépense, manquant ou excédent de caisse — impacte automatiquement le CA net du jour.
model OperationCaisse {
  id          String   @id @default(cuid())
  type        String   // "Depense" | "Manquant" | "Excedent"
  date        DateTime @default(now())
  depotId     String
  depot       Depot    @relation(fields: [depotId], references: [id])
  motif       String
  montant     Int
  annulee     Boolean  @default(false)
  saisieParId String
  saisiePar   User     @relation(fields: [saisieParId], references: [id])
  createdAt   DateTime @default(now())
}

// Trace des opérations sensibles (suppression de vente, annulation d'une dépense...).
model JournalAudit {
  id            String   @id @default(cuid())
  utilisateurId String
  utilisateur   User     @relation(fields: [utilisateurId], references: [id])
  action        String   // ex: "suppression_vente", "annulation_operation_caisse"
  cibleType     String   // ex: "Vente", "OperationCaisse"
  cibleId       String
  details       String?
  date          DateTime @default(now())
}
